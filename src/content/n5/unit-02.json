  "grammar": [
    {
      "id": "n5-u02-g01",
      "title": "これ・それ・あれ・どれ — this, that, which",
      "pattern": "これ / それ / あれ は N です",
      "meaning": "This / that / that over there is N",
      "explanation": "これ means \"this thing\" near you, the speaker. それ is \"that thing\" near the person you're talking to, and あれ is \"that thing over there\", far from both of you. どれ means \"which one?\" when choosing from three or more. These words stand alone like nouns — never put another noun right after them.",
      "notes": [
        "どれ is a question word, so it never comes before は: say ケンさんのかばんはどれですか, not どれはケンさんのかばんですか.",
        "If someone asks about それ (near you), answer with これ, and vice versa."
      ],
      "examples": [
        {
          "jp": "これは本[ほん]です。",
          "en": "This is a book."
        },
        {
          "jp": "それは何[なん]ですか。",
          "en": "What is that?"
        },
        {
          "jp": "あれは私[わたし]の車[くるま]です。",
          "en": "That (over there) is my car."
        },
        {
          "jp": "ラジさんの傘[かさ]はどれですか。",
          "en": "Which umbrella is Raj's?"
        }
      ],
      "drills": [
        {
