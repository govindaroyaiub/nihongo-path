  "grammar": [
    {
      "id": "n5-u01-g01",
      "title": "は〜です — \"A is B\"",
      "pattern": "A は B です",
      "meaning": "A is B (polite)",
      "explanation": "This is the first sentence pattern in Japanese. は marks the topic — what you're talking about — and です ends the sentence politely, like \"is / am / are\". The particle は is written with the hiragana は but pronounced \"wa\". Japanese drops the subject when it's obvious, so 学生です alone can mean \"I'm a student.\"",
      "notes": [
        "は is pronounced \"wa\" when it is a particle.",
        "です has no change for I / you / he / she / they.",
        "Never use さん about yourself."
      ],
      "examples": [
        {
          "jp": "私[わたし]は学生[がくせい]です。",
          "en": "I am a student."
        },
        {
          "jp": "田中[たなか]さんは先生[せんせい]です。",
          "en": "Mr. Tanaka is a teacher."
        },
        {
          "jp": "ラジさんはインド人[じん]です。",
          "en": "Raj is Indian."
        }
      ],
      "drills": [
        {
          "type": "choice",
          "jp": "私[わたし]＿学生[がくせい]です。",
          "answer": "は",
          "options": [
            "は",
            "か",
            "を",
            "の"
          ],
          "en": "I am a student."
        },
        {
          "type": "choice",
          "jp": "田中[たなか]さんは先生[せんせい]＿。",
          "answer": "です",
          "options": [
            "です",
            "は",
            "か",
            "の"
          ],
          "en": "Mr. Tanaka is a teacher."
        },
        {
          "type": "order",
          "tokens": [
            "私[わたし]は",
            "医者[いしゃ]",
            "です。"
          ],
          "en": "I am a doctor."
        },
        {
          "type": "order",
          "tokens": [
            "マリアさんは",
            "ブラジル人[じん]",
            "です。"
          ],
          "en": "Maria is Brazilian."
        }
      ]
    },
    {
      "id": "n5-u01-g02",
      "title": "じゃありません — \"A is not B\"",
      "pattern": "A は B じゃありません",
      "meaning": "A is not B (polite negative)",
      "explanation": "To say something is NOT, swap です for じゃありません. In writing and formal speech you'll also see ではありません — same meaning, a little more formal. In casual polite speech じゃないです is common too.",
      "notes": [
        "じゃ is a contraction of では.",
        "ではありません is more formal than じゃありません."
      ],
      "examples": [
        {
          "jp": "私[わたし]は先生[せんせい]じゃありません。",
          "en": "I am not a teacher."
        },
        {
          "jp": "ジョンさんは日本人[にほんじん]じゃありません。",
          "en": "John is not Japanese."
        },
        {
          "jp": "山田[やまだ]さんは医者[いしゃ]ではありません。",
          "en": "Ms. Yamada is not a doctor."
        }
      ],
      "drills": [
        {
          "type": "choice",
          "jp": "私[わたし]は先生[せんせい]＿。",
          "answer": "じゃありません",
          "options": [
            "じゃありません",
            "ですか",
            "も",
            "の"
          ],
          "en": "I am not a teacher."
        },
        {
          "type": "choice",
          "jp": "ケンさんは医者[いしゃ]＿ありません。",
          "answer": "では",
          "options": [
            "では",
            "です",
            "は",
            "か"
          ],
          "en": "Ken is not a doctor."
        },
        {
          "type": "order",
          "tokens": [
            "ジョンさんは",
            "日本人[にほんじん]",
            "じゃありません。"
          ],
          "en": "John is not Japanese."
        }
      ]
    },
    {
      "id": "n5-u01-g03",
      "title": "か — making a question",
      "pattern": "A は B ですか",
      "meaning": "Is A B?",
      "explanation": "Add か to the end of a sentence to make it a question — no word order change needed. Your voice goes up at the end. Answer with はい (yes) or いいえ (no). In Japanese writing a question still ends with 。, not ?.",
      "notes": [
        "Answer: はい、そうです (yes, that's right) / いいえ、ちがいます (no, that's wrong).",
        "With question words: お名前は何ですか。 — What is your name?"
      ],
      "examples": [
        {
          "jp": "あなたは学生[がくせい]ですか。",
          "en": "Are you a student?"
        },
        {
          "jp": "はい、学生[がくせい]です。",
          "en": "Yes, I'm a student."
        },
        {
          "jp": "お名前[なまえ]は何[なん]ですか。",
          "en": "What is your name?"
        }
      ],
      "drills": [
        {
          "type": "choice",
          "jp": "あなたは学生[がくせい]です＿。",
          "answer": "か",
          "options": [
            "か",
            "は",
            "も",
            "の"
          ],
          "en": "Are you a student?"
        },
        {
          "type": "choice",
          "jp": "お名前[なまえ]は＿ですか。",
          "answer": "何[なん]",
          "options": [
            "何[なん]",
            "はい",
            "私[わたし]",
            "さん"
          ],
          "en": "What is your name?"
        },
        {
          "type": "order",
          "tokens": [
            "山田[やまだ]さんは",
            "先生[せんせい]",
            "ですか。"
          ],
          "en": "Is Ms. Yamada a teacher?"
        }
      ]
    },
    {
      "id": "n5-u01-g04",
      "title": "の — \"of\", possession",
      "pattern": "A の B",
      "meaning": "A's B / B of A",
      "explanation": "の links two nouns. The first noun describes or owns the second: 私の名前 = my name, 日本語の先生 = a teacher of Japanese, さくら大学の学生 = a student at Sakura University. Read it backwards into English: A の B → B of A.",
      "notes": [
        "The owner always comes first.",
        "私の = my, あなたの = your."
      ],
      "examples": [
        {
          "jp": "私[わたし]の名前[なまえ]はラジです。",
          "en": "My name is Raj."
        },
        {
          "jp": "日本語[にほんご]の先生[せんせい]です。",
          "en": "I'm a Japanese teacher (teacher of Japanese)."
        },
        {
          "jp": "さくら大学[だいがく]の学生[がくせい]です。",
          "en": "I'm a student at Sakura University."
        }
      ],
      "drills": [
        {
          "type": "choice",
          "jp": "私[わたし]＿名前[なまえ]はケンです。",
          "answer": "の",
          "options": [
            "の",
            "を",
            "か",
            "に"
          ],
          "en": "My name is Ken."
        },
        {
          "type": "choice",
          "jp": "日本語[にほんご]の＿です。",
          "answer": "先生[せんせい]",
          "options": [
            "先生[せんせい]",
            "はい",
            "か",
            "何[なん]"
          ],
          "en": "I'm a Japanese teacher."
        },
        {
          "type": "order",
          "tokens": [
