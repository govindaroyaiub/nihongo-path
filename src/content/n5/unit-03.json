  "grammar": [
    {
      "id": "n5-u03-g01",
      "title": "ここ・そこ・あそこ・どこ — here, there, where",
      "pattern": "ここ は N です / N は どこ ですか",
      "meaning": "This place is N / Where is N?",
      "explanation": "ここ, そこ, あそこ and どこ are the place words of the これ / それ / あれ / どれ family. ここ is \"here\" (near me), そこ is \"there\" (near you), あそこ is \"over there\" (far from both of us), and どこ is \"where?\". To ask where something is, say N はどこですか. こちら, そちら, あちら and どちら are the polite versions, and they also mean \"this way / that way\".",
      "notes": [
        "Staff in shops and hotels almost always use こちら / あちら to be polite.",
        "お国はどちらですか is a polite way to ask which country someone is from."
      ],
      "examples": [
        {
          "jp": "ここは図書館[としょかん]です。",
          "en": "This (place) is the library."
        },
