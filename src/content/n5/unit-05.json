  "grammar": [
    {
      "id": "n5-u05-g01",
      "title": "Big numbers — 百, 千, 万",
      "pattern": "十一 … 九十九, 百, 千, 万",
      "meaning": "numbers from 11 up to 10,000",
      "explanation": "Japanese numbers are built like blocks. 11 is 十一 (ten-one), 20 is 二十 (two-ten) and 25 is 二十五 (two-ten-five). The same idea continues upward: 百 is 100, 千 is 1,000 and 万 is 10,000, so 350 is 三百五十. 10,000 is its own unit, 一万, so 20,000 is 二万 (two ten-thousands). A few combinations change their sound and are best learned as words: 三百 (さんびゃく), 六百 (ろっぴゃく), 八百 (はっぴゃく), 三千 (さんぜん), 八千 (はっせん).",
      "notes": [
        "100 and 1,000 are just 百 and 千 (no 一 in front), but 10,000 is 一万 (いちまん).",
        "In big numbers 4 is よん (四百 よんひゃく), 7 is なな (七千 ななせん) and 9 is きゅう (九百 きゅうひゃく).",
        "Prices: number + 円 (えん): 五百円."
      ],
      "examples": [
        {
          "jp": "これは三百円[さんびゃくえん]です。",
          "en": "This is 300 yen."
        },
        {
          "jp": "この本[ほん]は千五百円[せんごひゃくえん]です。",
          "en": "This book is 1,500 yen."
        },
        {
          "jp": "このかばんは八千円[はっせんえん]です。",
          "en": "This bag is 8,000 yen."
        },
        {
          "jp": "この時計[とけい]は二万円[にまんえん]です。",
          "en": "This watch is 20,000 yen."
        }
      ],
